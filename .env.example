# MariaDB (shared database — the Rust backend reads/owns the schema)
DB_NAME=lista_compras
DB_USER=lista_user
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=change-me-root-password

# Rust backend (defaults shown; usually set in docker-compose)
RUST_PORT=8766
RUST_BIND=0.0.0.0
RUST_LOG=info,sqlx=warn,tower_http=info
# Absolute base URL used to build password-recovery links in emails
APP_BASE_URL=https://listaisto.pt

# Email (SMTP — password recovery + notifications)
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=465
EMAIL_HOST_USER=geral@listaisto.pt
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=ListaIsto <geral@listaisto.pt>
