# ┌─────────────────────────────────────────────────────────────────┐
# │ Caddy serves the React SPA (baked into /srv) and proxies the JSON │
# │ API to the Rust backend. SPA fallback → index.html for client     │
# │ routes (/, /entrar, /link/:token, …).                             │
# │                                                                   │
# │ DOMÍNIO: quando tiveres domínio, o bloco listaisto.pt obtém       │
# │ certificado HTTPS (Let's Encrypt) automaticamente.                │
# └─────────────────────────────────────────────────────────────────┘

(app) {
	handle /api/* {
		reverse_proxy rust:8766
	}
	handle {
		root * /srv
		# Content-hashed build assets can be cached forever; HTML (and SPA
		# fallback routes) must revalidate so a new deploy is picked up at once.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Catch-all on :80 — responds to localhost AND the host's LAN IP, so other
# devices on the same network reach the app at http://<LAN-IP>.
:80 {
	import app
}

listaisto.pt {
	import app
}

# NOTA: Descomentar quando o DNS de www.listaisto.pt apontar para o servidor.
# www.listaisto.pt {
#     redir https://listaisto.pt{uri} permanent
# }
